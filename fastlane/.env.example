# Copy this file to fastlane/.env for local configuration.
# Keep shell-compatible KEY=value syntax.

# Firebase tester targeting. Use either groups or testers.
FIREBASE_GROUPS=qa
# FIREBASE_TESTERS=one@example.com,two@example.com

# Optional release notes.
# FIREBASE_RELEASE_NOTES=Internal test build
# FIREBASE_RELEASE_NOTES_FILE=release_notes.txt

# Enable verbose Firebase App Distribution API logging while debugging failures.
# FIREBASE_DEBUG=true

# Preferred for CI or machines without Firebase CLI login.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/firebase-service-account.json

# App ids are already defined in fastlane/Fastfile. Override only if needed.
# FIREBASE_ANDROID_DEV_APP_ID=1:938473995616:android:bc128abff73c587ab8f205
# FIREBASE_ANDROID_PROD_APP_ID=1:938473995616:android:e71013969697bb3e
# FIREBASE_IOS_PROD_APP_ID=1:938473995616:ios:e71013969697bb3e
# FIREBASE_IOS_DEV_APP_ID=1:938473995616:ios:50962cc1dcb0b00fb8f205

# iOS build export method used by build_and_upload_firebase.sh.
IOS_EXPORT_METHOD=ad-hoc

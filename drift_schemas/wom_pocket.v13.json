  "fixed_sql": [
    {
      "name": "wom",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wom\" (\"Id\" TEXT NOT NULL UNIQUE, \"SourceName\" TEXT NOT NULL, \"Secret\" TEXT NOT NULL, \"geohash\" TEXT NOT NULL, \"Aim\" TEXT NOT NULL, \"SourceId\" TEXT NOT NULL, \"TransactionId\" INTEGER NOT NULL, \"addedOn\" INTEGER NOT NULL, \"spentOn\" INTEGER NULL, \"spent\" INTEGER NOT NULL, \"Latitude\" REAL NOT NULL, \"Longitude\" REAL NOT NULL, \"donation_id\" TEXT NULL, PRIMARY KEY (\"Id\"));"
        }
      ]
    },
    {
      "name": "aims",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"aims\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"code\" TEXT NOT NULL, \"titles\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"Id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source\" TEXT NOT NULL, \"Aim\" TEXT NOT NULL, \"Timestamp\" INTEGER NOT NULL, \"type\" INTEGER NOT NULL, \"size\" INTEGER NOT NULL, \"ackUrl\" TEXT NULL, \"pin\" TEXT NULL, \"deadline\" INTEGER NULL, \"link\" TEXT NULL);"
        }
